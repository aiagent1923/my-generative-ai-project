# Server configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/retellai_clone?schema=public"

# Security
JWT_SECRET="your_jwt_secret"
BCRYPT_SALT_ROUNDS=10

# Socket.io
SOCKET_IO_PATH="/socket.io"

# Third-party providers (optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
OPENAI_API_KEY=""
